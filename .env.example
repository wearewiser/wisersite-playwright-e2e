# Copy this file to .env and adjust values as needed.
# Points this suite at wisersite-and-payload-plugin's tenant Postgres analytics
# warehouse (read-only — see src/db/wisersite-db-client.ts) and its seeded master
# admin user. See that repo's dev/.env.example / docs/tenant-sql-local-setup.md for
# how to reach the warehouse locally.

# Must be "localhost", not "127.0.0.1" — the app's login redirect resolves
# differently depending on the request Host header.
WISERSITE_BASE_URL=http://localhost:3000

TENANT_SQL_HOST=127.0.0.1
TENANT_SQL_PORT=5432
TENANT_SQL_USER=demo
TENANT_SQL_PASSWORD=your-tenant-sql-password
TENANT_SQL_NAME=demo

ADMIN_EMAIL=your-master-user-email@example.com
ADMIN_PASSWORD=your-master-user-password
